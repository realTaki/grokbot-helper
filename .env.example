# Shared secret callers must present (required at runtime)
CALLER_SECRET=

# Incoming header that carries the secret (default Authorization)
CALLER_SECRET_HEADER=

# Target POST URL (required at runtime)
WEBHOOK_URL=

# Optional secret value
WEBHOOK_SECRET=

# Header that carries the secret (default Authorization)
WEBHOOK_SECRET_HEADER=

# Optional extra headers as a JSON object
WEBHOOK_HEADERS=

# Inclusive sleep lower bound in seconds (default 90)
SLEEP_MIN_SECONDS=

# Inclusive sleep upper bound in seconds (default 120)
SLEEP_MAX_SECONDS=
